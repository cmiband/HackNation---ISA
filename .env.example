# Host storage path (default is ./storage in repo root)
HOST_STORAGE_PATH=./storage

# Database URL
DATABASE_URL=sqlite:////app/storage/app.db

# Storage paths inside container
STORAGE_DIR=/app/storage
FILES_DIR=/app/storage/files

# LLM (cloud API in the MVP). LLM_PROVIDER=none disables the LLM (deterministic fallbacks).
LLM_PROVIDER=
# Pydantic AI model string "<provider>:<model>". We start with Google Gemini.
LLM_MODEL=google:gemini-3.6-flash
# API key for the chosen provider (read by Pydantic AI). Never commit the real key.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible endpoint (Ollama / vLLM / proxy). If set, LLM_MODEL is a plain model name.
LLM_BASE_URL=
LLM_API_KEY=

# Development
AI_MOCK=1

# Retrieval
EMBEDDING_MODEL=intfloat/multilingual-e5-base
VECTOR_BACKEND=lancedb
