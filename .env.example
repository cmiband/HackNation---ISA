# Host storage path (default is ./storage in repo root)
HOST_STORAGE_PATH=./storage

# Database and storage paths for native runs (relative to the repo root).
# Inside Docker, compose.yaml overrides them with /app/storage paths.
DATABASE_URL=sqlite:///storage/app.db
STORAGE_DIR=storage
FILES_DIR=storage/files

# LLM (cloud API in the MVP). LLM_PROVIDER=none disables the LLM (deterministic fallbacks).
LLM_PROVIDER=
# Pydantic AI model string "<provider>:<model>". We start with Google Gemini.
# Comma-separated = fallback chain: when a model fails (e.g. free-tier daily quota used up -> HTTP 429),
# the next one is used. Flash Lite models are last (larger daily quota, lower quality).
LLM_MODEL=google:gemini-3.6-flash,google:gemini-3.8-flash,google:gemini-3.7-flash,google:gemini-3.5-flash,google:gemini-3-flash-preview,google:gemini-2.5-flash,google:gemini-3.5-flash-lite,google:gemini-3.1-flash-lite
# API key for the chosen provider (read by Pydantic AI). Never commit the real key.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: OpenAI-compatible endpoint (Ollama / vLLM / proxy). If set, LLM_MODEL is a plain model name.
LLM_BASE_URL=
LLM_API_KEY=

# Development
# 1 = canned AI results for UI development (no LLM, no models); 0 = real AI service
AI_MOCK=0

# Retrieval
EMBEDDING_MODEL=sdadas/mmlw-roberta-base

# Vector DB (Qdrant). Docker sets QDRANT_URL=http://qdrant:6333 itself.
# Native runs: start the server with `docker compose up -d qdrant` and use localhost.
# Empty QDRANT_URL = embedded local mode in QDRANT_PATH (one process at a time; fine for quick tests).
QDRANT_URL=http://localhost:6333
QDRANT_PATH=storage/qdrant
QDRANT_COLLECTION=archive_questions
# Dense size of the embedding model (sdadas/mmlw-roberta-base = 768)
DENSE_VECTOR_SIZE=768

# Hide the Pydantic AI startup banner
PYDANTIC_AI_NO_BANNER=1

# Similar-case thresholds (cosine of the dense embeddings; see ai_service/service.py). Optional.
# SIMILARITY_DUPLICATE=0.92
# SIMILARITY_LOW=0.91
# SIMILARITY_FLOOR=0.75
